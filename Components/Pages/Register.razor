@page "/register"
@inject NavigationManager Navigation
@inject AuthenticationService AuthService

<div class="register-container">
    <h3>Register</h3>
    <EditForm Model="registerModel" OnValidSubmit="HandleRegisterAsync">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label>Username:</label>
            <InputText @bind-Value="registerModel.Username" class="form-control" />
        </div>

        <div class="form-group">
            <label>Password:</label>
            <InputText @bind-Value="registerModel.Password" type="password" class="form-control" />
        </div>

        <div class="form-group">
            <label>Currency:</label>
            <InputSelect @bind-Value="registerModel.Currency" class="form-control">
                <option value="">Select Currency</option>
                <option value="USD">USD - US Dollar</option>
                <option value="NPR">NPR - Nepalese Rupee</option>
            </InputSelect>
        </div>

        <button type="submit" class="btn-submit">Register</button>
        <button type="button" class="btn-secondary" @onclick="NavigateToLogin">Back to Login</button>
    </EditForm>
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="error-message">@errorMessage</p>
    }
</div>

<style>
    .register-container {
        max-width: 400px;
        margin: 50px auto;
        padding: 20px;
        border: 1px solid #ddd;
        border-radius: 8px;
        background-color: #f9f9f9;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

        .register-container h3 {
            text-align: center;
            margin-bottom: 20px;
            font-size: 1.5rem;
            color: #333;
        }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-size: 0.9rem;
            color: #555;
        }

    .form-control {
        width: 100%;
        padding: 8px 10px;
        border: 1px solid #ccc;
        border-radius: 4px;
        font-size: 1rem;
    }

        .form-control:focus {
            outline: none;
            border-color: #007bff;
            box-shadow: 0 0 5px rgba(0, 123, 255, 0.5);
        }

    .btn-submit {
        width: 100%;
        padding: 10px;
        background-color: #007bff;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        color: white;
        cursor: pointer;
    }

        .btn-submit:hover {
            background-color: #0056b3;
        }

    .btn-secondary {
        width: 100%;
        padding: 10px;
        background-color: #6c757d;
        border: none;
        border-radius: 4px;
        font-size: 1rem;
        color: white;
        cursor: pointer;
        margin-top: 10px;
    }

        .btn-secondary:hover {
            background-color: #5a6268;
        }

    .error-message {
        color: red;
        text-align: center;
        margin-top: 10px;
    }
</style>

@code {
    // Model to store user registration information
    private RegisterModel registerModel = new();
    private string? errorMessage;

    // HandleRegisterAsync is called when the user submits the registration form
    // It validates the input and attempts to register the user via AuthService
    private async Task HandleRegisterAsync()
    {
        try
        {
            // Check if currency is selected
            if (string.IsNullOrEmpty(registerModel.Currency))
            {
                errorMessage = "Please select a currency.";
                return;
            }

            // Attempt to register the user and get success status and message
            var (success, message) = await AuthService.RegisterAsync(
                registerModel.Username,
                registerModel.Password,
                registerModel.Currency
            );

            // If registration is successful, navigate to login page
            if (success)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage = message;
            }
        }
        catch (Exception ex)
        {
            errorMessage = "An error occurred during registration. Please try again.";
        }
    }

    // NavigateToLogin is called to navigate to the login page
    private void NavigateToLogin()
    {
        Navigation.NavigateTo("/login");
    }

    // RegisterModel class holds the registration form data (Username, Password, Currency)
    private class RegisterModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string Currency { get; set; } = string.Empty;
    }
}