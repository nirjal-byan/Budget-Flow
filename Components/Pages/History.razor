@page "/history"
@inject BudgetFlow.Services.TransactionHistoryService HistoryService
@inject BudgetFlow.Services.AuthenticationService AuthService

<div class="transaction-history-container">
    @if (!AuthService.IsAuthenticated)
    {
        <div class="login-message">
            <h2>Please Login First</h2>
            <p>You need to be logged in to view transaction history.</p>
            <a href="login" class="login-link">Go to Login Page</a>
        </div>
    }
    else
    {
        <h2>Transaction History</h2>

        <!-- Search, Filters, and Date Inputs -->
        <div class="search-and-filters">
            <input type="text"
                   @oninput="OnSearchTermChanged"
                   class="search-input"
                   placeholder="Search in table..." />
            <select @onchange="OnTypeChanged" class="filter-dropdown">
                <option value="All">All Types</option>
                <option value="Debit">Debit</option>
                <option value="Credit">Credit</option>
            </select>
            <select @onchange="OnTagChanged" class="filter-dropdown">
                <option value="All">All Tags</option>
                @foreach (var tag in tags)
                {
                    <option value="@tag">@tag</option>
                }
            </select>
            <InputDate @bind-Value="startDate"
                       @bind-Value:after="UpdateFilteredTransactionsAsync"
                       class="compact-date-input"
                       placeholder="Start Date" />
            <InputDate @bind-Value="endDate"
                       @bind-Value:after="UpdateFilteredTransactionsAsync"
                       class="compact-date-input"
                       placeholder="End Date" />
        </div>

        <!-- Summary -->
        <div class="transaction-summary">
            <p>Total Transactions: <strong>@filteredTransactions.Count</strong></p>
            <p>Total Amount: <strong>$@filteredTransactions.Sum(t => t.Amount)</strong></p>
        </div>

        <!-- Table -->
        <table class="transaction-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Amount Spent</th>
                    <th>Title</th>
                    <th>Tags</th>
                    <th>Date</th>
                    <th>Notes</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var transaction in filteredTransactions)
                {
                    <tr>
                        <td>@transaction.Id</td>
                        <td>@transaction.Type</td>
                        <td>$@transaction.Amount</td>
                        <td>@transaction.Title</td>
                        <td>@transaction.Tag</td>
                        <td>@(transaction.Date.HasValue ? transaction.Date.Value.ToShortDateString() : "N/A")</td>
                        <td>@transaction.Notes</td>
                        <td>
                            <button @onclick="() => DeleteTransaction(transaction.Id)" class="delete-button">Delete</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

<style>
    .transaction-history-container {
        max-width: 800px;
        margin: 20px auto;
        font-family: Arial, sans-serif;
        padding: 20px;
        background: #fdfdfd;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
        font-size: 24px;
        font-weight: bold;
    }

    .login-message {
        text-align: center;
        padding: 40px 20px;
    }

        .login-message p {
            margin: 20px 0;
            color: #666;
            font-size: 16px;
        }

    .login-link {
        display: inline-block;
        padding: 10px 20px;
        background-color: #333;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        font-size: 16px;
        transition: background-color 0.3s;
    }

        .login-link:hover {
            background-color: #555;
        }

    .search-and-filters {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        gap: 10px;
        flex-wrap: wrap;
    }

    .search-input, .filter-dropdown, .compact-date-input {
        padding: 8px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
    }

    .search-input {
        flex: 2;
        min-width: 200px;
    }

    .filter-dropdown, .compact-date-input {
        flex: 1;
        min-width: 120px;
    }

    .transaction-summary {
        margin-bottom: 20px;
        font-size: 16px;
    }

    .transaction-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 14px;
    }

        .transaction-table th, .transaction-table td {
            border: 1px solid #ddd;
            padding: 10px;
            text-align: center;
        }

        .transaction-table th {
            background-color: #333;
            color: #fff;
        }

        .transaction-table tbody tr:nth-child(even) {
            background-color: #f9f9f9;
        }

    .delete-button {
        background-color: #333; /* Matches your existing dark theme colors */
        color: #fff;
        border: none;
        padding: 8px 12px;
        border-radius: 5px;
        font-size: 14px;
        cursor: pointer;
        transition: background-color 0.3s ease, transform 0.2s ease;
    }

        .delete-button:hover {
            background-color: #555; /* Slightly lighter for hover */
            transform: scale(1.05); /* Add a slight zoom effect */
        }

        .delete-button:active {
            background-color: #111; /* Darker for pressed state */
            transform: scale(1); /* Reset zoom on click */
        }

</style>

@code {
    // Variables to store search filters and transaction data
    private string searchTerm = string.Empty;
    private string selectedType = "All";
    private string selectedTag = "All";
    private DateTime? startDate;
    private DateTime? endDate;
    private List<string> tags = new List<string>();
    private List<BudgetFlow.Models.Transaction> filteredTransactions = new List<BudgetFlow.Models.Transaction>();

    // OnInitializedAsync is called when the component is initialized to check authentication and load tags and transactions
    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await UpdateTagsAsync();
            await UpdateFilteredTransactionsAsync();
        }
    }

    // UpdateTagsAsync fetches all available tags from the service and updates the tags list
    private async Task UpdateTagsAsync()
    {
        try
        {
            tags = await HistoryService.GetAllTagsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            tags = new List<string>();
        }
        catch (Exception)
        {
            tags = new List<string>();
        }
    }

    // UpdateFilteredTransactionsAsync fetches filtered transactions based on search term, type, and tag
    private async Task UpdateFilteredTransactionsAsync()
    {
        try
        {
            filteredTransactions = await HistoryService.GetFilteredTransactionsAsync(searchTerm, selectedType, selectedTag);

            // Filter transactions further based on the selected date range
            if (startDate.HasValue && endDate.HasValue)
            {
                filteredTransactions = filteredTransactions
                    .Where(t => t.Date >= startDate && t.Date <= endDate)
                    .OrderBy(t => t.Date)
                    .ToList();
            }
        }
        catch (UnauthorizedAccessException)
        {
            filteredTransactions = new List<BudgetFlow.Models.Transaction>();
        }
        catch (Exception)
        {
            filteredTransactions = new List<BudgetFlow.Models.Transaction>();
        }
    }

    // OnSearchTermChanged is called when the user changes the search term, and it updates the filtered transactions
    private async Task OnSearchTermChanged(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? string.Empty;
        await UpdateFilteredTransactionsAsync();
    }

    // OnTypeChanged is called when the user changes the transaction type filter, and it updates the filtered transactions
    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        selectedType = e.Value?.ToString() ?? "All";
        await UpdateFilteredTransactionsAsync();
    }

    // OnTagChanged is called when the user changes the tag filter, and it updates the filtered transactions
    private async Task OnTagChanged(ChangeEventArgs e)
    {
        selectedTag = e.Value?.ToString() ?? "All";
        await UpdateFilteredTransactionsAsync();
    }

    // DeleteTransaction removes a transaction by its ID and updates the filtered transactions list
    private async Task DeleteTransaction(int id)
    {
        try
        {
            await HistoryService.DeleteTransactionAsync(id);
            await UpdateFilteredTransactionsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting transaction: {ex.Message}");
        }
    }
}
