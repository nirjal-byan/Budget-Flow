@page "/debt"
@inject BudgetFlow.Services.AddDebtService DebtService
@inject BudgetFlow.Services.AuthenticationService AuthService

<!-- Container for the debt form -->
<div class="debt-container">
    <!-- Check if the user is authenticated -->
    @if (!AuthService.IsAuthenticated)
    {
        <!-- Show a login prompt if the user is not logged in -->
        <div class="login-message">
            <h2>Please Login First</h2>
            <p>You need to be logged in to add debts.</p>
            <a href="login" class="login-link">Go to Login Page</a>
        </div>
    }
    else
    {
        <!-- Form to add a new debt -->
        <h3 class="title">Add a Debt</h3>
        <EditForm Model="debt" OnValidSubmit="HandleSaveAsync" class="form-container">
            <!-- Validation components -->
            <DataAnnotationsValidator />
            <ValidationSummary />

            <!-- Input fields for debt details -->
            <div class="form-group">
                <label>Title</label>
                <InputText @bind-Value="debt.Title" class="form-control" placeholder="Enter a Title." />
            </div>
            <div class="form-group">
                <label>Tag</label>
                <InputSelect @bind-Value="debt.Tag" class="form-control">
                    <option value="">-- Type or Select a Tag --</option>
                    <option value="Loan">Loan</option>
                    <option value="Mortgage">Mortgage</option>
                    <option value="Credit Card">Credit Card</option>
                </InputSelect>
            </div>
            <div class="form-group">
                <label>Source</label>
                <InputText @bind-Value="debt.Source" class="form-control" placeholder="Enter Source." />
            </div>
            <div class="form-group">
                <label>Amount</label>
                <InputNumber @bind-Value="debt.Amount" class="form-control" placeholder="Enter an Amount." />
            </div>
            <div class="form-group">
                <label>Due Date</label>
                <InputDate @bind-Value="debt.DueDate" class="form-control" />
            </div>
            <div class="form-group">
                <label>Notes (Optional)</label>
                <InputTextArea @bind-Value="debt.Notes" class="form-control" placeholder="Enter a note." />
            </div>

            <!-- Submit button -->
            <button type="submit" class="btn-save">Save</button>
        </EditForm>

        <!-- Success message after saving a debt -->
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <p class="success-message">@successMessage</p>
        }
    }
</div>

<!-- Styles for the debt form -->
<style>
    /* Styles for the main container */
    .debt-container {
        max-width: 500px;
        margin: 50px auto;
        padding: 20px;
        background: #fdfdfd;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        font-family: Arial, sans-serif;
    }

    .title {
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
    }

    /* Form styles */
    .form-container {
        margin-top: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
            color: #555;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #333;
            outline: none;
        }

    .btn-save {
        display: block;
        width: 100%;
        background-color: #333;
        color: white;
        padding: 10px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
    }

        .btn-save:hover {
            background-color: #555;
        }

    /* Message styles */
    .success-message {
        text-align: center;
        color: green;
        font-size: 16px;
        margin-top: 10px;
    }

    .login-message {
        text-align: center;
        padding: 40px 20px;
    }

        .login-message p {
            margin: 20px 0;
            color: #666;
            font-size: 16px;
        }

    .login-link {
        display: inline-block;
        padding: 10px 20px;
        background-color: #333;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        font-size: 16px;
        transition: background-color 0.3s;
    }

        .login-link:hover {
            background-color: #555;
        }
</style>

@code {
    // Model to hold the debt details
    private BudgetFlow.Models.Debt debt = new();
    private string successMessage; // Message to display after saving a debt

    // Method to handle saving the debt
    private async Task HandleSaveAsync()
    {
        try
        {
            if (!AuthService.IsAuthenticated)
            {
                successMessage = "You must be logged in to add debts.";
                return;
            }

            await DebtService.AddDebtAsync(debt); // Save the debt using the service
            successMessage = $"Debt '{debt.Title}' added successfully!"; // Success message
            debt = new BudgetFlow.Models.Debt(); // Reset the form
        }
        catch (UnauthorizedAccessException)
        {
            successMessage = "You must be logged in to add debts."; // Error if user is not logged in
        }
        catch (Exception ex)
        {
            successMessage = $"Error adding debt: {ex.Message}"; // General error message
        }
    }
}
