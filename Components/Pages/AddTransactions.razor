@page "/transactions"
@inject BudgetFlow.Services.AddTransactionService TransactionService
@inject BudgetFlow.Services.AuthenticationService AuthService
@inject BudgetFlow.Services.BalanceService BalanceService

<div class="transaction-container">
    @if (!AuthService.IsAuthenticated)
    {
        <div class="login-message">
            <h2>Please Login First</h2>
            <p>You need to be logged in to add transactions.</p>
            <a href="login" class="login-link">Go to Login Page</a>
        </div>
    }
    else
    {
        @if (currentBalance.HasValue)
        {
            <div class="balance-info @(currentBalance.Value >= 0 ? "positive" : "negative")">
                Current Balance: $@currentBalance.Value.ToString("N2")
            </div>
        }

        <h3 class="title">Add a transaction</h3>
        <div class="transaction-type">
            <button class="btn-type @(transaction.Type == "Debit" ? "btn-debit active" : "btn-debit")"
                    @onclick='() => transaction.Type = "Debit"'>
                Debit
            </button>
            <button class="btn-type @(transaction.Type == "Credit" ? "btn-credit active" : "btn-credit")"
                    @onclick='() => transaction.Type = "Credit"'>
                Credit
            </button>
        </div>

        <EditForm Model="transaction" OnValidSubmit="HandleSaveAsync" class="form-container">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label>Title</label>
                <InputText @bind-Value="transaction.Title" class="form-control" placeholder="Enter a Title." />
            </div>

            <div class="form-group">
                <label>Tag</label>
                <InputSelect @bind-Value="transaction.Tag" class="form-control">
                    <option value="">-- Select a Tag --</option>
                    @foreach (var tag in tagOptions)
                    {
                        <option value="@tag">@tag</option>
                    }
                </InputSelect>
            </div>

            <div class="form-group">
                <label>Add Custom Tag</label>
                <div style="display: flex; gap: 10px; align-items: center;">
                    <InputText @bind-Value="newTag" class="form-control" placeholder="Enter a custom tag" />
                    <button type="button" class="btn-save btn-add-tag" @onclick="AddCustomTag">Add</button>
                </div>
                @if (!string.IsNullOrEmpty(tagErrorMessage))
                {
                    <p class="error-message">@tagErrorMessage</p>
                }
            </div>

            <div class="form-group">
                <label>Amount</label>
                <InputNumber @bind-Value="transaction.Amount" class="form-control" placeholder="Enter an Amount." />
            </div>

            <div class="form-group">
                <label>Date</label>
                <InputDate @bind-Value="transaction.Date" class="form-control" />
            </div>

            <div class="form-group">
                <label>Notes (Optional)</label>
                <InputTextArea @bind-Value="transaction.Notes" class="form-control" placeholder="Enter a note." />
            </div>

            <button type="submit" class="btn-save">Save</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <p class="error-message">@errorMessage</p>
        }
        @if (!string.IsNullOrEmpty(successMessage))
        {
            <p class="success-message">@successMessage</p>
        }
    }
</div>

<style>
    .transaction-container {
        max-width: 500px;
        margin: 50px auto;
        padding: 20px;
        background: #fdfdfd;
        border-radius: 8px;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
        font-family: Arial, sans-serif;
    }

    .balance-info {
        text-align: center;
        padding: 15px;
        margin-bottom: 20px;
        border-radius: 8px;
        font-size: 18px;
        font-weight: bold;
    }

    .positive {
        background-color: #d4edda;
        color: #155724;
    }

    .negative {
        background-color: #f8d7da;
        color: #721c24;
    }

    .login-message {
        text-align: center;
        padding: 40px 20px;
    }

        .login-message p {
            margin: 20px 0;
            color: #666;
            font-size: 16px;
        }

    .login-link {
        display: inline-block;
        padding: 10px 20px;
        background-color: #333;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        font-size: 16px;
        transition: background-color 0.3s;
    }

        .login-link:hover {
            background-color: #555;
        }

    .title {
        text-align: center;
        font-size: 24px;
        font-weight: bold;
        margin-bottom: 20px;
        color: #333;
    }

    .transaction-type {
        display: flex;
        justify-content: center;
        margin-bottom: 20px;
    }

    .btn-type {
        padding: 10px 20px;
        border: 1px solid black;
        border-radius: 5px;
        margin: 0 10px;
        cursor: pointer;
        font-size: 16px;
        background-color: white;
        color: black;
        transition: background-color 0.2s, color 0.2s;
    }

    .btn-debit.active,
    .btn-credit.active {
        background-color: black;
        color: white;
    }

    .btn-type:hover {
        opacity: 0.8;
    }

    .form-container {
        margin-top: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

        .form-group label {
            display: block;
            font-weight: bold;
            margin-bottom: 5px;
            color: #555;
        }

    .form-control {
        width: 100%;
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 5px;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #333;
            outline: none;
        }

    .btn-save {
        display: block;
        width: 100%;
        background-color: #333;
        color: white;
        padding: 10px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        cursor: pointer;
    }

        .btn-save:hover {
            background-color: #555;
        }

    .error-message {
        color: #dc3545;
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        padding: 10px;
        border-radius: 4px;
        margin-top: 10px;
        text-align: center;
    }

    .success-message {
        text-align: center;
        color: green;
        font-size: 16px;
        margin-top: 10px;
    }

    .btn-add-tag {
        width: auto !important;
        padding: 10px 20px !important;
    }
</style>

@code {
    private BudgetFlow.Models.Transaction transaction = new();
    private string successMessage;
    private string errorMessage;
    private string newTag;
    private string tagErrorMessage;
    private decimal? currentBalance;
    private List<string> tagOptions = new List<string>
    {
        "Monthly",
        "Yearly",
        "Rent",
        "Groceries",
        "EMI",
        "Fuel",
        "Food",
        "Transport",
        "Entertainment",
        "Clothes",
        "Gadgets",
        "Miscellaneous"
    };

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            currentBalance = await BalanceService.GetCurrentBalanceAsync();
        }
    }

    private async Task HandleSaveAsync()
    {
        try
        {
            errorMessage = string.Empty;
            successMessage = string.Empty;

            if (!AuthService.IsAuthenticated)
            {
                errorMessage = "You must be logged in to add transactions.";
                return;
            }

            if (string.IsNullOrEmpty(transaction.Type))
            {
                errorMessage = "Please select Debit or Credit before saving!";
                return;
            }

            if (transaction.Type == "Debit")
            {
                bool hasSufficientBalance = await BalanceService.HasSufficientBalanceAsync(transaction.Amount);
                if (!hasSufficientBalance)
                {
                    errorMessage = "Insufficient balance! Please add funds before making this transaction.";
                    return;
                }
            }

            await TransactionService.AddTransactionAsync(transaction);
            successMessage = $"Transaction '{transaction.Title}' of type '{transaction.Type}' added successfully!";
            transaction = new BudgetFlow.Models.Transaction();

            // Update the current balance after successful transaction
            currentBalance = await BalanceService.GetCurrentBalanceAsync();
        }
        catch (UnauthorizedAccessException)
        {
            errorMessage = "You must be logged in to add transactions.";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error adding transaction: {ex.Message}";
        }
    }

    private void AddCustomTag()
    {
        tagErrorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(newTag))
        {
            tagErrorMessage = "Custom tag cannot be empty.";
            return;
        }

        if (tagOptions.Contains(newTag))
        {
            tagErrorMessage = "This tag already exists.";
            return;
        }

        tagOptions.Add(newTag);
        newTag = string.Empty;
    }
}