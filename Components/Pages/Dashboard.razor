@page "/dashboard"
@inject BudgetFlow.Services.BalanceService BalanceService
@inject BudgetFlow.Services.AuthenticationService AuthService

<div class="dashboard-container">
    @if (!AuthService.IsAuthenticated)
    {
        <div class="login-message">
            <h2>Please Login First</h2>
            <p>You need to be logged in to view your dashboard.</p>
            <a href="login" class="login-link">Go to Login Page</a>
        </div>
    }
    else
    {
        <h3 class="welcome-title">Welcome to your Dashboard</h3>

        @if (dashboardSummary != null)
        {
            <div class="balance-cards">
                <div class="balance-card @GetBalanceClass(dashboardSummary.CurrentBalance)">
                    <h4>Total Balance</h4>
                    <p class="amount">$@dashboardSummary.CurrentBalance.ToString("N2")</p>
                    <p class="description">Total of all transactions</p>
                </div>

                <div class="balance-card debt">
                    <h4>Pending Debts</h4>
                    <p class="amount">$@dashboardSummary.TotalPendingDebts.ToString("N2")</p>
                    <p class="description">Total pending debts</p>
                </div>

                <div class="balance-card @GetBalanceClass(dashboardSummary.AvailableBalance)">
                    <h4>Available Balance</h4>
                    <p class="amount">$@dashboardSummary.AvailableBalance.ToString("N2")</p>
                    <p class="description">After deducting pending debts</p>
                </div>
            </div>
        }
        else
        {
            <div class="loading">Loading balance information...</div>
        }
    }
</div>

<style>
    .dashboard-container {
        padding: 20px;
        max-width: 1200px;
        margin: 0 auto;
    }

    .welcome-title {
        text-align: center;
        margin-bottom: 30px;
        color: #333;
        font-size: 28px;
    }

    .balance-cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
        gap: 20px;
        margin-top: 20px;
    }

    .balance-card {
        background: white;
        padding: 20px;
        border-radius: 10px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        text-align: center;
    }

        .balance-card h4 {
            margin: 0;
            color: #666;
            font-size: 18px;
        }

        .balance-card .amount {
            font-size: 32px;
            font-weight: bold;
            margin: 15px 0;
        }

        .balance-card .description {
            color: #666;
            font-size: 14px;
            margin: 0;
        }

    .positive {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
    }

        .positive h4, .positive .description {
            color: rgba(255, 255, 255, 0.8);
        }

    .negative {
        background: linear-gradient(135deg, #dc3545, #c82333);
        color: white;
    }

        .negative h4, .negative .description {
            color: rgba(255, 255, 255, 0.8);
        }

    .debt {
        background: linear-gradient(135deg, #fd7e14, #f17722);
        color: white;
    }

        .debt h4, .debt .description {
            color: rgba(255, 255, 255, 0.8);
        }

    .loading {
        text-align: center;
        padding: 40px;
        color: #666;
        font-size: 18px;
    }

    .login-message {
        text-align: center;
        padding: 40px 20px;
    }

        .login-message h2 {
            margin-bottom: 15px;
            color: #333;
        }

        .login-message p {
            margin: 20px 0;
            color: #666;
            font-size: 16px;
        }

    .login-link {
        display: inline-block;
        padding: 10px 20px;
        background-color: #333;
        color: white;
        text-decoration: none;
        border-radius: 5px;
        font-size: 16px;
        transition: background-color 0.3s;
    }

        .login-link:hover {
            background-color: #555;
            text-decoration: none;
        }
</style>

@code {
    private DashboardSummary? dashboardSummary;

    protected override async Task OnInitializedAsync()
    {
        if (AuthService.IsAuthenticated)
        {
            await LoadDashboardDataAsync();
        }
    }

    private async Task LoadDashboardDataAsync()
    {
        try
        {
            dashboardSummary = await BalanceService.GetDashboardSummaryAsync();
        }
        catch (Exception)
        {
            // Handle any errors
        }
    }

    private string GetBalanceClass(decimal amount)
    {
        return amount >= 0 ? "positive" : "negative";
    }
}