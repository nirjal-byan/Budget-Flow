<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BudgetFlow</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/home" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/login">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Login
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/register">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Register
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/transactions">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Add Transactions
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/debt">
                <span class="bi bi-credit-card-fill-nav-menu" aria-hidden="true"></span> Add Debt
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/history">
                <span class="bi bi-credit-card-fill-nav-menu" aria-hidden="true"></span> Transaction History
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/pending-debts">
                <span class="bi bi-credit-card-fill-nav-menu" aria-hidden="true"></span> Pending Debts
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="#" @onclick="HandleLogout">
                <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Logout
            </NavLink>
        </div>

        @code {
            [Inject] AuthenticationService AuthService { get; set; } = default!;
            [Inject] NavigationManager Navigation { get; set; } = default!;

            private async Task HandleLogout()
            {
                await AuthService.LogoutAsync();
                Navigation.NavigateTo("/login", true);
            }
        }

    </nav>
</div>

