<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">BudgetFlow</a>
        <input type="checkbox" title="Navigation menu" class="navbar-toggler" />
    </div>
</div>
<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/dashboard" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/login">
                <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Login
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/register">
                <span class="bi bi-person-plus-nav-menu" aria-hidden="true"></span> Register
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/transactions">
                <span class="bi bi-cash-stack-nav-menu" aria-hidden="true"></span> Add Transactions
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/debt">
                <span class="bi bi-credit-card-nav-menu" aria-hidden="true"></span> Add Debt
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/history">
                <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Transaction History
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="/pending-debts">
                <span class="bi bi-exclamation-circle-nav-menu" aria-hidden="true"></span> Pending Debts
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="#" @onclick="HandleLogout">
                <span class="bi bi-box-arrow-in-right-nav-menu" aria-hidden="true"></span> Logout
            </NavLink>
        </div>
    </nav>

    @code {
        private bool isLoggingOut = false;

        private async Task HandleLogout()
        {
            isLoggingOut = true;
            StateHasChanged(); // Force a UI update to show the loading state.

            await AuthService.LogoutAsync();
            isLoggingOut = false;
            Navigation.NavigateTo("/login", true); // Ensures navigation to login page.
        }

        [Inject] AuthenticationService AuthService { get; set; } = default!;
        [Inject] NavigationManager Navigation { get; set; } = default!;
    }
</div>